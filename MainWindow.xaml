<Window x:Class="RelayRdp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RelayRdp"
        Title="Relay — удалённый рабочий стол" Width="1040" Height="790" MinWidth="790" MinHeight="590"
        WindowStartupLocation="CenterScreen" Background="#F5F7FC" Foreground="{StaticResource Ink}" FontFamily="Segoe UI" FontSize="14"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="ApplicationCommands.Save" />
        <KeyBinding Key="N" Modifiers="Control" Command="ApplicationCommands.New" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Save" Executed="SaveCommand_Executed" />
        <CommandBinding Command="ApplicationCommands.New" Executed="NewCommand_Executed" />
    </Window.CommandBindings>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="234" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="#142139">
            <Grid Margin="20,28,20,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,30">
                    <Border Width="42" Height="42" CornerRadius="11" Background="#385DE0">
                        <Path Data="M3,4 H19 V15 H3 Z M8,19 H14 M11,15 V19 M7,9 H14 M11,6 L14,9 L11,12"
                              Stroke="White" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" Width="23" Height="23" Stretch="Uniform" />
                    </Border>
                    <StackPanel Margin="11,-2,0,0">
                        <TextBlock Text="Relay" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource SidebarText}" />
                        <TextBlock Text="Удалённый рабочий стол" FontSize="11" Foreground="{StaticResource SidebarMuted}" />
                    </StackPanel>
                </StackPanel>
                <Button Grid.Row="1" Content="＋  Новый профиль" Command="ApplicationCommands.New"
                        Style="{StaticResource SidebarButton}" />
                <TextBlock Grid.Row="2" Text="Сохранённые профили" Margin="2,25,0,9"
                           FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource SidebarMuted}" />
                <Grid Grid.Row="3">
                    <TextBlock x:Name="NoProfiles" Text="Здесь появятся ваши&#x0a;подключения." Margin="2,8,0,0"
                               Foreground="{StaticResource SidebarMuted}" FontSize="13" />
                    <ListBox x:Name="Profiles" Background="Transparent" BorderThickness="0" Padding="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Сохранённые профили"
                             ItemContainerStyle="{StaticResource ProfileItem}" SelectionChanged="Profiles_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Data="M1,2 H15 V11 H1 Z M5,14 H11 M8,11 V14" Stroke="#A9C0FF" StrokeThickness="1.25"
                                          Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Left" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"
                                                   Foreground="{StaticResource SidebarText}" />
                                        <TextBlock Text="{Binding Address}" TextTrimming="CharacterEllipsis" FontSize="12"
                                                   Foreground="{StaticResource SidebarMuted}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
                <Button Grid.Row="4" Content="Открыть файл .rdp…" Click="OpenRdp_Click" Style="{StaticResource SidebarButton}" />
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="34,24,34,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,13">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="PageTitle" Text="Новое подключение" FontSize="28" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="PageSubtitle" Text="Параметры сеанса" Style="{StaticResource Hint}" Margin="0,4,0,0" />
                </StackPanel>
                <Button x:Name="MoreButton" Grid.Column="1" Content="Действия ▾" Click="More_Click"
                        Style="{StaticResource QuietButton}" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Button.ContextMenu>
                        <ContextMenu Placement="Custom">
                            <MenuItem Header="Экспортировать .rdp…" Click="Export_Click" />
                            <MenuItem Header="Экспортировать и открыть настройки Windows…" Click="ExportAndEdit_Click" />
                            <MenuItem Header="Открыть существующий .rdp в настройках Windows…" Click="EditRdp_Click" />
                            <Separator />
                            <MenuItem x:Name="DeleteMenuItem" Header="Удалить профиль…" Click="Delete_Click" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </Grid>

            <TabControl x:Name="Settings" Grid.Row="1" Style="{StaticResource SettingsTabs}">
                <TabItem Header="Подключение" Style="{StaticResource SettingsTab}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel Margin="0,15,10,4">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Удалённый компьютер" Style="{StaticResource SectionTitle}" />
                                    <Label Content="Адрес компьютера" Target="{Binding ElementName=AddressInput}" Margin="0,13,0,0" />
                                    <TextBox x:Name="AddressInput" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" MaxLength="300"
                                             AutomationProperties.Name="Адрес компьютера" />
                                    <TextBlock Text="Имя компьютера, IP-адрес или адрес с портом, например 192.168.1.20:3389."
                                               Style="{StaticResource Hint}" Margin="0,6,0,0" />
                                    <Grid Margin="0,13,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <Label Content="Название профиля" Target="{Binding ElementName=NameInput}" />
                                            <TextBox x:Name="NameInput" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="100"
                                                     AutomationProperties.Name="Название профиля" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <Label Content="Пользователь Windows" Target="{Binding ElementName=UserInput}" />
                                            <TextBox x:Name="UserInput" Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" MaxLength="256"
                                                     AutomationProperties.Name="Пользователь Windows" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="Windows предложит войти при подключении." Style="{StaticResource Hint}" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Маршрут подключения" Style="{StaticResource SectionTitle}" />
                                    <Label Content="Шлюз RD Gateway (необязательно)" Target="{Binding ElementName=GatewayInput}" Margin="0,12,0,0" />
                                    <TextBox x:Name="GatewayInput" Text="{Binding Gateway, UpdateSourceTrigger=PropertyChanged}" MaxLength="300"
                                             AutomationProperties.Name="Шлюз RD Gateway" />
                                    <CheckBox Content="Административный сеанс" IsChecked="{Binding AdminSession}" Margin="0,10,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Background="#EAF0FF" BorderBrush="#D6E0FA" Padding="17,13">
                                <StackPanel>
                                    <TextBlock Text="Компьютер без монитора" FontWeight="SemiBold" Foreground="#243E81" />
                                    <TextBlock Text="На удалённом ПК включите «Удалённый рабочий стол» в параметрах Windows. Для RDP-сеанса физический монитор не нужен."
                                               Style="{StaticResource Hint}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Экран" Style="{StaticResource SettingsTab}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel Margin="0,15,10,4">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Экран удалённого сеанса" Style="{StaticResource SectionTitle}" />
                                    <Label Content="Режим отображения" Target="{Binding ElementName=ScreenInput}" Margin="0,13,0,0" />
                                    <ComboBox x:Name="ScreenInput" SelectedValuePath="Tag" SelectedValue="{Binding Screen, Mode=TwoWay}"
                                              AutomationProperties.Name="Режим отображения">
                                        <ComboBoxItem Content="В окне" Tag="{x:Static local:ScreenMode.Window}" />
                                        <ComboBoxItem Content="Во весь экран" Tag="{x:Static local:ScreenMode.FullScreen}" />
                                        <ComboBoxItem Content="На всех мониторах клиента" Tag="{x:Static local:ScreenMode.MultiMonitor}" />
                                    </ComboBox>
                                    <StackPanel Margin="0,13,0,0">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="IsEnabled" Value="False" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedValue, ElementName=ScreenInput}" Value="{x:Static local:ScreenMode.Window}">
                                                        <Setter Property="IsEnabled" Value="True" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Label Content="Разрешение в оконном режиме" Target="{Binding ElementName=SizeInput}" />
                                        <ComboBox x:Name="SizeInput" SelectedValuePath="Tag" SelectedValue="{Binding Size, Mode=TwoWay}"
                                                  AutomationProperties.Name="Разрешение в оконном режиме">
                                            <ComboBoxItem Content="По умолчанию" Tag="{x:Static local:DesktopSize.Default}" />
                                            <ComboBoxItem Content="1280 × 720" Tag="{x:Static local:DesktopSize.Hd}" />
                                            <ComboBoxItem Content="1920 × 1080" Tag="{x:Static local:DesktopSize.FullHd}" />
                                            <ComboBoxItem Content="2560 × 1440" Tag="{x:Static local:DesktopSize.Qhd}" />
                                            <ComboBoxItem Content="3840 × 2160" Tag="{x:Static local:DesktopSize.UltraHd}" />
                                        </ComboBox>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Производительность" Style="{StaticResource SectionTitle}" />
                                    <CheckBox Content="Уменьшить визуальные эффекты" IsChecked="{Binding ReducedEffects}" Margin="0,10,0,0" />
                                    <TextBlock Text="Отключает запрос на обои, анимацию меню и сглаживание шрифтов в удалённом сеансе."
                                               Style="{StaticResource Hint}" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Файлы и устройства" Style="{StaticResource SettingsTab}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel Margin="0,15,10,4">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Буфер обмена и файлы" Style="{StaticResource SectionTitle}" />
                                    <CheckBox Content="Общий буфер обмена" IsChecked="{Binding Clipboard}" Margin="0,10,0,0" />
                                    <TextBlock Text="Копируйте текст, изображения и файлы между компьютерами, если это разрешено политикой Windows."
                                               Style="{StaticResource Hint}" Margin="0,5,0,0" />
                                    <Label Content="Локальные диски" Target="{Binding ElementName=DrivesInput}" Margin="0,13,0,0" />
                                    <ComboBox x:Name="DrivesInput" SelectedValuePath="Tag" SelectedValue="{Binding Drives, Mode=TwoWay}"
                                              AutomationProperties.Name="Локальные диски">
                                        <ComboBoxItem Content="Не перенаправлять" Tag="{x:Static local:DriveMode.None}" />
                                        <ComboBoxItem Content="Выбранные диски" Tag="{x:Static local:DriveMode.Selected}" />
                                        <ComboBoxItem Content="Все диски, включая подключённые позже" Tag="{x:Static local:DriveMode.All}" />
                                        <ComboBoxItem Content="Только диски, подключённые после входа" Tag="{x:Static local:DriveMode.ConnectedLater}" />
                                    </ComboBox>
                                    <StackPanel Margin="0,13,0,0">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedValue, ElementName=DrivesInput}" Value="{x:Static local:DriveMode.Selected}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Label Content="Буквы дисков через запятую, например D, E" Target="{Binding ElementName=DriveLettersInput}" />
                                        <TextBox x:Name="DriveLettersInput" Text="{Binding DriveLetters, UpdateSourceTrigger=PropertyChanged}" MaxLength="160"
                                                 AutomationProperties.Name="Буквы дисков" />
                                    </StackPanel>
                                    <TextBlock Text="Выбранные диски появятся в разделе «Этот компьютер» в удалённом Проводнике."
                                               Style="{StaticResource Hint}" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Периферия" Style="{StaticResource SectionTitle}" />
                                    <CheckBox Content="Доступные USB-устройства" IsChecked="{Binding Usb}" Margin="0,10,0,0" />
                                    <TextBlock Text="Доступ зависит от устройства, драйвера и политик RDP. Для флешек обычно подходит перенаправление дисков."
                                               Style="{StaticResource Hint}" Margin="0,5,0,8" />
                                    <UniformGrid Columns="2">
                                        <CheckBox Content="Камеры" IsChecked="{Binding Cameras}" />
                                        <CheckBox Content="Микрофон" IsChecked="{Binding Microphone}" />
                                        <CheckBox Content="Устройства MTP/PTP" IsChecked="{Binding PortableDevices}" />
                                        <CheckBox Content="Принтеры" IsChecked="{Binding Printers}" />
                                        <CheckBox Content="Смарт-карты" IsChecked="{Binding SmartCards}" />
                                        <CheckBox Content="COM-порты" IsChecked="{Binding SerialPorts}" />
                                        <CheckBox Content="Ключи WebAuthn" IsChecked="{Binding SecurityKeys}" />
                                    </UniformGrid>
                                    <Label Content="Воспроизведение звука" Target="{Binding ElementName=AudioInput}" Margin="0,13,0,0" />
                                    <ComboBox x:Name="AudioInput" SelectedValuePath="Tag" SelectedValue="{Binding Audio, Mode=TwoWay}"
                                              AutomationProperties.Name="Воспроизведение звука">
                                        <ComboBoxItem Content="На этом компьютере" Tag="{x:Static local:AudioMode.Local}" />
                                        <ComboBoxItem Content="На удалённом компьютере" Tag="{x:Static local:AudioMode.Remote}" />
                                        <ComboBoxItem Content="Без звука" Tag="{x:Static local:AudioMode.Muted}" />
                                    </ComboBox>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Если Windows покажет диалог подключения со списком ресурсов, отметьте в нём нужные устройства, диски и буфер обмена."
                                       Style="{StaticResource Hint}" Margin="2,0,4,12" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,13,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="Status" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,14,0"
                               AutomationProperties.LiveSetting="Polite" />
                    <Button Grid.Column="1" Content="Сохранить" Command="ApplicationCommands.Save" Margin="0,0,9,0"
                            Style="{StaticResource QuietButton}" />
                    <Button Grid.Column="2" Content="Подключиться  →" Click="Connect_Click" IsDefault="True"
                            Style="{StaticResource PrimaryButton}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
